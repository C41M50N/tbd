{
  "name": "tbd",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "if [ -e .git ]; then git config core.hooksPath .githooks; fi",
    "dev": "portless tbd vite dev",
    "build": "vite build",
    "start": "varlock run -- srvx serve --prod --dir . --static dist/client --entry dist/server/server.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- drizzle-kit migrate",
    "db:push": "varlock run -- drizzle-kit push",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/router-plugin": "^1.168.45",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.545.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "srvx": "^0.11.20",
    "tailwindcss": "^4.3.2",
    "varlock": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@varlock/vite-integration": "^1.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^28.1.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.72.0",
    "portless": "^0.15.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
